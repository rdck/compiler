   )
 )

(rule
 (target Lexer.ml)
 (deps   Lexer.mll)
 (action (chdir %{workspace_root}
          (run %{bin:ocamllex} -q -o %{target} %{deps}))))

(env
 (dev
  (flags
   (:standard -warn-error -A)
)))
